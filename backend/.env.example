# ──────────────────────────────────────────────
# k8scan SaaS – Environment Variables Template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────

# Application
APP_NAME=k8scan
APP_ENV=development          # development | production

# Frontend origin (used for CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Database (default: SQLite for development)
DATABASE_URL=sqlite:///./k8scan.db
# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@host:5432/k8scan

# JWT – generate with: python3 -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_RANDOM_SECRET

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Stripe ──────────────────────────────────
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Create products/prices in Stripe Dashboard, then paste the price IDs here
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_ANNUAL=price_...
STRIPE_PRICE_ENT_MONTHLY=price_...
STRIPE_PRICE_ENT_ANNUAL=price_...

# ── File upload ──────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=52428800    # 50 MB
FILE_RETENTION_HOURS=24
